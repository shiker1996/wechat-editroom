{
  "schemaVersion": 1,
  "id": "tech-twitter-collector",
  "name": "TechTwitter 全面精选",
  "version": "1.1.0",
  "kind": "collector",
  "entry": "./adapter.mjs",
  "riskLevel": "network-read",
  "capabilities": ["cap_collect_x"],
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 20, "title": "每类最多条数" },
      "timeoutMs": { "type": "integer", "minimum": 5000, "maximum": 120000, "default": 30000, "title": "请求超时（毫秒）" }
    }
  },
  "outputSchema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "object" } } } },
  "runtime": { "timeoutMs": 120000, "concurrency": "parallel" },
  "collector": {
    "sourceTypes": ["x"],
    "sourceConfigSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 20 },
        "timeoutMs": { "type": "integer", "minimum": 5000, "maximum": 120000, "default": 30000 }
      }
    }
  }
}
