{
  "id": "ai-visual-document-writer",
  "name": "AI 视觉文档分块写入",
  "version": "1.0.0",
  "capabilities": [
    "cap_filesystem_project_document_write"
  ],
  "entry": "./adapter.mjs",
  "riskLevel": "local-write",
  "pathInputs": [
    "path"
  ],
  "inputSchema": {
    "type": "object",
    "required": [
      "operation",
      "sessionId",
      "path"
    ],
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "begin",
          "append",
          "replace-page",
          "finish",
          "abort"
        ]
      },
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "requestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "content": {
        "type": "string",
        "maxLength": 16384
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 0
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "requirePageAnchors": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "operation",
      "sessionId",
      "path",
      "status",
      "revision",
      "totalBytes",
      "sha256"
    ],
    "properties": {
      "operation": { "type": "string" },
      "sessionId": { "type": "string" },
      "path": { "type": "string" },
      "status": { "type": "string" },
      "revision": { "type": "integer" },
      "appendedBytes": { "type": "integer" },
      "page": { "type": "integer" },
      "replacedBytes": { "type": "integer" },
      "insertedBytes": { "type": "integer" },
      "totalBytes": { "type": "integer" },
      "sha256": { "type": "string" },
      "alreadyApplied": { "type": "boolean" }
    }
  },
  "description": "在授权的候选工作目录内原样追加 AI 视觉 HTML/CSS 分块；也可按 CARD-PAGE 页码锚点精确替换一个 .page 根元素，不改写其他页面。",
  "enabledByDefault": true,
  "schemaVersion": 1,
  "kind": "tool",
  "runtime": {}
}
