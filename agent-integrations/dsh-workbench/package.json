{
  "name": "jianzi-content-workbench",
  "version": "1.0.17",
  "icon": "./icon.svg",
  "description": "见字工作台：面向微信公众号创作者的内容创作平台，覆盖热点采集、选题研判、文章创作、排版与封面制作。",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiker1996/wechat-editroom",
    "directory": "agent-integrations/dsh-workbench"
  },
  "type": "module",
  "exports": {
    ".": "./dsh/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dsh",
    "lib",
    "shared",
    "assets",
    "mcp-server.mjs",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": { "build": "node ./build.mjs" }
}
