{
    "name": "wechat-newsroom-workbench",
    "version": "0.8.0",
    "main": "desktop/main.mjs",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "本地优先的公众号热点、成稿与排版工作台",
    "scripts": {
        "start": "node --disable-warning=ExperimentalWarning server.mjs",
        "desktop": "electron .",
        "desktop:dev": "npm run build && electron .",
        "desktop:dir": "npm run build && electron-builder --dir --config.npmRebuild=false",
        "desktop:win": "npm run desktop:dir && npm run desktop:win:from-dir",
        "desktop:win:from-dir": "electron-builder --win --prepackaged dist\\win-unpacked --config.npmRebuild=false",
        "setup": "node scripts/runtime/setup.mjs",
        "dev": "node --disable-warning=ExperimentalWarning --watch --watch-path=server.mjs --watch-path=server server.mjs",
        "test": "node --disable-warning=ExperimentalWarning --test test/**/*.test.mjs",
        "test:fast": "node scripts/build/test-fast.mjs",
        "event-resolution:backfill": "node scripts/migration/backfill-event-resolution.mjs",
        "topic-score:replay": "node scripts/migration/replay-topic-score.mjs",
        "build": "npm run build:styles && node scripts/build/build.mjs",
        "build:styles": "node scripts/build/build-styles.mjs",
        "check:legacy-config-guidance": "node scripts/quality/check-legacy-configuration-guidance.mjs",
    "check:theme-colors": "node scripts/quality/check-theme-colors.mjs",
    "check:theme-colors:all": "node scripts/quality/check-theme-colors.mjs --all",
    "check:theme-colors:ui": "node scripts/quality/check-theme-colors.mjs --all --ui",
    "migrate:production-colors": "node scripts/quality/migrate-production-colors.mjs",
    "migrate:system-console-colors": "node scripts/quality/migrate-system-console-colors.mjs",
    "migrate:editor-theme-colors": "node scripts/quality/migrate-editor-theme-colors.mjs",
    "migrate:chrome-colors": "node scripts/quality/migrate-chrome-colors.mjs",
    "migrate:social-card-colors": "node scripts/quality/migrate-social-card-colors.mjs",
    "migrate:topics-accessibility-colors": "node scripts/quality/migrate-topics-accessibility-colors.mjs",
    "prune:palette-tokens": "node scripts/quality/prune-generated-palette-tokens.mjs",
    "fix:theme-colors": "node scripts/quality/check-theme-colors.mjs --fix",
        "check:harness-boundaries": "node scripts/quality/check-harness-boundaries.mjs",
        "postinstall": "node scripts/runtime/install-skill-deps.mjs",
        "build:watch": "node --watch scripts/build/build.mjs",
        "site:export": "node scripts/demo/export-vercel-demo.mjs",
        "check:style-coverage": "node scripts/quality/check-style-coverage.mjs",
        "skill:validate": "node scripts/quality/validate-skill-package.mjs",
        "plugin:validate": "node scripts/quality/validate-tool-plugin.mjs",
        "plugin:audit-boundaries": "node scripts/quality/audit-plugin-boundaries.mjs",
        "plugin:verify-distribution": "node scripts/quality/verify-plugin-distribution.mjs",
        "plugin:baseline-boundaries": "node scripts/quality/snapshot-plugin-boundary-baseline.mjs",
        "config:baseline": "node scripts/quality/snapshot-legacy-configuration.mjs",
        "config:migrate": "node --disable-warning=ExperimentalWarning scripts/migration/migrate-legacy-configuration.mjs",
        "capability:baseline": "node scripts/quality/snapshot-tool-call-baseline.mjs",
        "capability:gates": "node --disable-warning=ExperimentalWarning scripts/quality/check-consumer-capability-gates.mjs",
        "capability:consumer-baseline": "node --disable-warning=ExperimentalWarning scripts/quality/snapshot-consumer-capability-baseline.mjs",
        "capability:migrate-routes": "node scripts/migration/migrate-capability-routes.mjs",
        "release": "node scripts/release/release.mjs"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1109.0",
        "markdown-it": "^14.1.0",
        "npm": "11.6.2",
        "pnpm": "10.34.5",
        "unzipper": "0.12.5"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.16.0",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.shiker.wechat-newsroom-workbench",
        "productName": "见字",
        "asar": false,
        "files": [
            "desktop/**/*",
            "server.mjs",
            "server/**/*",
            "public/**/*",
            "plugins/**/*",
            "skills/**/*",
            "writing-skills/**/*",
            "themes/**/*",
            "config/**/*",
            "scripts/runtime/**/*",
            "package.json",
            "account-context.example.json",
            "!RSSHub/**/*",
            "!data/**/*",
            "!articles/**/*",
            "!topics/**/*",
            "!social-cards/**/*",
            "!logs/**/*",
            "!output/**/*",
            "!dist/**/*",
            "!.node-runtime/**/*",
            "!skills/**/node_modules/**/*",
            "!node_modules/electron/**/*",
            "!node_modules/electron-builder/**/*",
            "!node_modules/@electron/**/*",
            "!node_modules/@mermaid-js/**/*",
            "!node_modules/puppeteer/**/*"
        ],
        "extraResources": [
            {
                "from": ".node-runtime/node-v24.12.0/node.exe",
                "to": "node-runtime/node.exe"
            },
            {
                "from": "RSSHub",
                "to": "rsshub-source",
                "filter": [
                    "**/*",
                    "!node_modules/**/*",
                    "!.git/**/*",
                    "!logs/**/*",
                    "!.env",
                    "!.env.*",
                    "!package-lock.json"
                ]
            }
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "jianzhi-${version}-win-${arch}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "runAfterFinish": true,
            "installerLanguages": [
                "zh_CN"
            ],
            "language": "2052",
            "include": "build/installer.nsh",
            "menuCategory": "见字",
            "uninstallDisplayName": "见字工作台",
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "见字"
        }
    }
}
